+        pub(crate) async fn fetch_london_weather() -> Option<(f64, String)> {
+            let client = reqwest::Client::builder()
+                .user_agent("AlexsTube/1.0.0 (contact: point@gemini.com)")
+                .build()
+                .ok()?;
+
+            let mut temp1 = None;
+            if let Ok(resp) = client.get("https://api.open-meteo.com/v1/forecast?latitude=51.5074&longitude=-0.1278&current_weather=true").send().await {
+                if let Ok(json) = resp.json::<serde_json::Value>().await {
+                    if let Some(t) = json.get("current_weather").and_then(|cw| cw.get("temperature")).and_then(|v| v.as_f64()) {
+                        temp1 = Some(t);
+                    }
+                }
+            }
+
+            let mut temp2 = None;
+            if let Ok(resp) = client.get("https://api.met.no/weatherapi/locationforecast/2.0/compact?lat=51.5074&lon=-0.1278").send().await {
+                if let Ok(json) = resp.json::<serde_json::Value>().await {
+                    if let Some(t) = json.get("properties")
