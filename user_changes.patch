+            pub(crate) fn parse_stations_from_json(
+                data: &Value,
+            ) -> Result<Vec<Station>, Box<dyn std::error::Error>> {
+                let mut stations = Vec::new();
+                if let Some(elements) = data.get("elements").and_then(|v| v.as_array()) {
+                    for el in elements {
+                        if el.get("type").and_then(|v| v.as_str()) == Some("node") {
+                            let id_num = el.get("id").and_then(|v| v.as_i64()).unwrap_or(0);
+                            let lat = el.get("lat").and_then(|v| v.as_f64()).unwrap_or(0.0);
+                            let lon = el.get("lon").and_then(|v| v.as_f64()).unwrap_or(0.0);
+                            let tags = el.get("tags");
+
+                            let name = tags
+                                .and_then(|t| t.get("name"))
+                                .and_then(|v| v.as_str())
+                                .map(|s| s.to_string())
+                                .unwrap_or_else(|| format!("Unnamed Station {}", id_num));
+
+                            let is_historic = tags
+                                .map(|t| {
+                                    t.get("historic").is_some()
+                                        || t.get("disused").is_some()
+                                        || t.get("ceremonial").is_some()
+                                        || t.get("railway")
+                                            .and_then(|v| v.as_str())
+                                            .map(|s| s == "disused" || s == "abandoned")
+                                            .unwrap_or(false)
+                                })
+                                .unwrap_or(false);
+
+                            let mut station_lines = Vec::new();
+                            if is_historic {
+                                station_lines.push("historic".to_string());
+                            } else {
+                                let operator = tags
+                                    .and_then(|t| t.get("operator"))
+                                    .and_then(|v| v.as_str())
+                                    .unwrap_or("National Rail");
+                                station_lines.push(operator.to_string());
+                            }
+
+                            let st = Station {
+                                id: format!("overpass_{}", id_num),
+                                name,
+                                coord: Coordinate::new(lat, lon),
+                                lines: station_lines,
+                                is_interchange: false,
+                                is_open: !is_historic,
+                                zone: 0,
+                                is_historical: is_historic,
+                            };
+                            stations.push(st);
+                        }
+                    }
+                }
+                Ok(stations)
+            }
