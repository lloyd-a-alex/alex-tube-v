+                        .and_then(|v| v.as_f64()) {
+                        temp2 = Some(t);
+                    }
+                }
+            }
+
+            match (temp1, temp2) {
+                (Some(t1), Some(t2)) => {
+                    let avg = (t1 + t2) / 2.0;
