+                let mut last_error: Option<String> = None;
+
+                for (attempt, url) in all_urls.enumerate() {
+                    for retry in 0..3 {
+                        log_debug(&format!("OverpassApiClient::fetch_stations - attempt {}/url {}, retry {}/{} using {}", attempt + 1, attempt, retry + 1, 3, url));
+
+                        let response = match self
+                            .network
+                            .client
+                            .post(url)
+                            .form(&[("data", &query)])
+                            .send()
+                            .await
+                        {
+                            Ok(r) => r,
+                            Err(e) => {
+                                last_error = Some(e.to_string());
+                                continue;
+                            }
+                        };
+
+                        let status = response.status();
+                        if status == 429 || status == 503 {
+                            tokio::time::sleep(Duration::from_secs(2)).await;
+                            continue;
+                        }
+                        if !status.is_success() {
+                            last_error = Some(format!("HTTP status {}", status));
+                            break;
+                        }
+
+                        let val = match response.json::<Value>().await {
+                            Ok(j) => j,
+                            Err(e) => {
+                                last_error = Some(e.to_string());
+                                break;
+                            }
+                        };
+
+                        let stations = Self::parse_stations_from_json(&val)?;
+                        log_info(&format!(
+                            "OverpassApiClient::fetch_stations success - parsed {} stations",
+                            stations.len()
+                        ));
+                        return Ok(stations);
+                    }
+                }
