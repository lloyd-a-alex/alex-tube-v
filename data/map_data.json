  nationalrail: ['#7A8B99', '#90A4AE', '#607D8B', '#B0BEC5', '#455A64']
};

function getBranchColor(mode, index) {
  const colors = BRANCH_COLORS[mode] || [MODES[mode].baseColor];
  return colors[index % colors.length];
}

// ---- station icons: TfL roundels + National Rail double-arrow + Custom Tram roundel ----
const ROUNDEL = {
  tube:'#DC241F', overground:'#EE7C0E', elizabeth:'#6950A1', dlr:'#00A4A7', tram:'#84B817'
};

function roundelSVG(color, sz){
  return `<svg width="${sz}" height="${sz}" viewBox="0 0 36 36">
    <circle cx="18" cy="18" r="13.5" fill="#fff" stroke="${color}" stroke-width="6.5"/>
    <rect x="1.5" y="14" width="33" height="8" fill="#10069F"/></svg>`;
}

// Custom tram roundel - distinct design with green theme and T-style
function tramRoundelSVG(color, sz){
  return `<svg width="${sz}" height="${sz}" viewBox="0 0 36 36">
    <circle cx="18" cy="18" r="13.5" fill="#fff" stroke="${color}" stroke-width="5"/>
    <rect x="2" y="14" width="32" height="8" fill="${color}" rx="1"/>
    <rect x="14" y="2" width="8" height="32" fill="${color}" rx="1"/></svg>`;
}

function nrSVG(sz){
  const w = Math.round(sz*1.7);
  return `<svg width="${w}" height="${sz}" viewBox="0 0 68 40">
    <rect x="0.5" y="0.5" width="67" height="39" rx="5" fill="#fff" stroke="#c8c8c8"/>
    <g fill="#C81D11">
