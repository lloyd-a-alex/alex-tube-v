<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Alex Tube — Real London Rail Network</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
  :root { --bg:#0e1116; --panel:rgba(20,24,31,.92); --line:rgba(255,255,255,.10);
          --txt:#e8edf2; --muted:#93a1b0; --accent:#4aa3ff; }
  * { box-sizing:border-box; }
  html,body { margin:0; height:100%; font-family:Inter,-apple-system,Segoe UI,Roboto,system-ui,sans-serif; }
  #map { position:absolute; inset:0; background:#cfd6dd; }
  .panel { position:absolute; z-index:1000; background:var(--panel); color:var(--txt);
           border:1px solid var(--line); border-radius:14px; backdrop-filter:blur(10px);
           box-shadow:0 10px 40px rgba(0,0,0,.45); }
  #legend { top:14px; left:14px; width:248px; padding:14px 16px; max-height:calc(100% - 28px); overflow:auto; }
  #legend h1 { font-size:16px; margin:0 0 2px; letter-spacing:.3px; }
  #legend .sub { color:var(--muted); font-size:11px; margin-bottom:12px; }
  .group-title { font-size:10px; text-transform:uppercase; letter-spacing:.12em; color:var(--muted);
                 margin:12px 0 6px; }
  .row { display:flex; align-items:center; gap:9px; padding:4px 6px; border-radius:8px; cursor:pointer;
         user-select:none; font-size:13px; }
  .row:hover { background:rgba(255,255,255,.06); }
  .row input { accent-color:var(--accent); width:14px; height:14px; }
  .swatch { width:22px; height:6px; border-radius:3px; flex:0 0 auto; }
  .mode-ico { width:18px; height:18px; flex:0 0 auto; }
  #catchBtn { display:flex; align-items:center; gap:10px; width:100%; margin-top:10px; padding:11px 12px;
              border:1px solid var(--line); border-radius:10px; background:linear-gradient(180deg,#1d2632,#161c25);
              color:var(--txt); font-size:13px; font-weight:600; cursor:pointer; text-align:left; }
  #catchBtn:hover { border-color:var(--accent); }
  #catchBtn.on { background:linear-gradient(180deg,#7a1420,#54101a); border-color:#e0384b; }
  #catchBtn .dot { width:12px; height:12px; border-radius:3px; background:#e0384b; box-shadow:0 0 8px #e0384b; }
  #catchNote { font-size:11px; color:var(--muted); margin:6px 2px 0; line-height:1.4; }
  #stats { bottom:14px; left:14px; padding:9px 13px; font-size:11px; color:var(--muted); }
  #stats b { color:var(--txt); }
  .leaflet-bar a { background:var(--panel); color:var(--txt); border-bottom:1px solid var(--line); }
  .station-ico { display:flex; align-items:center; justify-content:center; }
  .leaflet-tooltip.st { background:rgba(12,16,22,.95); border:1px solid var(--line); color:#fff;
                        font-size:12px; font-weight:600; box-shadow:none; }
  .leaflet-tooltip.st::before { display:none; }
  #spin { position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
          background:#0e1116; color:#cfd6dd; z-index:2000; font-size:14px; letter-spacing:.04em; }
  #spin .b { width:34px; height:34px; border:3px solid rgba(255,255,255,.15); border-top-color:#4aa3ff;
             border-radius:50%; animation:sp 1s linear infinite; margin-right:14px; }
  @keyframes sp { to { transform:rotate(360deg); } }
</style>
</head>
<body>
<div id="spin"><div class="b"></div>Loading real London rail network…</div>
<div id="map"></div>

<div id="legend" class="panel">
  <h1>Alex Tube</h1>
  <div class="sub">Real TfL &amp; National Rail network · live OSM track geometry</div>
  <div id="toggles"></div>
  <button id="catchBtn">
    <span class="dot"></span><span>Catchment deserts</span>
  </button>
  <div id="catchNote">Highlights residential land more than <b>800&nbsp;m</b> from any rail station.</div>
</div>
<div id="stats" class="panel"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// UK-wide bounds for catchment area (excluding France)
const UK_BOUNDS = {
  minLat: 49.8,
  maxLat: 60.9,
  minLon: -8.2,
  maxLon: 1.8
};

const map = L.map('map', { preferCanvas:true, zoomControl:true, minZoom:5, maxZoom:18 })
             .setView([55.0, -3.0], 6);
L.control.scale({imperial:false}).addTo(map);

L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
  attribution:'&copy; OpenStreetMap &copy; CARTO · rail data &copy; OpenStreetMap contributors (ODbL)',
  subdomains:'abcd', maxZoom:19
}).addTo(map);

// dedicated panes for clean stacking order
map.createPane('nr');        map.getPane('nr').style.zIndex = 350;
map.createPane('tfl');       map.getPane('tfl').style.zIndex = 400;
map.createPane('deserts');   map.getPane('deserts').style.zIndex = 300;
map.createPane('stations');  map.getPane('stations').style.zIndex = 600;

const MODES = {
  tube:        { label:'Underground',  pane:'tfl', weight:3.2, baseColor:'#DC241F' },
  overground:  { label:'Overground',   pane:'tfl', weight:3.0, baseColor:'#EE7C0E' },
  elizabeth:   { label:'Elizabeth line',pane:'tfl', weight:3.2, baseColor:'#6950A1' },
  dlr:         { label:'DLR',          pane:'tfl', weight:3.0, baseColor:'#00A4A7' },
  tram:        { label:'Tramlink',     pane:'tfl', weight:2.6, baseColor:'#84B817' },
  nationalrail:{ label:'National Rail',pane:'nr',  weight:2.2, baseColor:'#7A8B99' },
};

// Branch-based sub-colors for operators (lighter/darker variants)
const BRANCH_COLORS = {
  tube: ['#DC241F', '#E53935', '#C62828', '#FF5252', '#B71C1C'],
  overground: ['#EE7C0E', '#FF9800', '#F57C00', '#FFB74D', '#E65100'],
  elizabeth: ['#6950A1', '#7E57C2', '#5E35B1', '#9575CD', '#4527A0'],
  dlr: ['#00A4A7', '#00BCD4', '#0097A7', '#26C6DA', '#00838F'],
