# =============================================================================
# Alex's Tube V — .gitignore
# =============================================================================

# Rust build artifacts
/target/
/target_new/
**/*.rs.bk

# Cargo: track lockfile for reproducible binary builds
# (Cargo.lock IS committed for applications)

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Qoder agent worktrees
.worktrees/

# Environment / secrets
.env
.env.*
!.env.example

# Qoder cache
.qoder/

# Misc
*.log
c++.txt
combined_code.txt
separate-project-dont-touch/
