# =============================================================================
# Alex's Tube V — .gitignore
# =============================================================================

# Rust build artifacts
/target/
/target_new/
**/*.rs.bk

# Cargo: track lockfile for reproducible binary builds
# (Cargo.lock IS committed for applications)

# IDE / Editor
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Dioxus build/cache
.dioxus/

# Environment / secrets
.env
.env.*
!.env.example

# Qoder agent worktrees
.worktrees/

# Qoder cache
.qoder/

# Crash reports and logs
crash_*.log
*.crash
*.log

# SQLite database files (runtime caches)
*.db
*.db-shm
*.db-wal

# Benchmark results
/target/criterion/

# Profiling output
*.prof
flamegraph.svg

# Misc
c++.txt
combined_code.txt
separate-project-dont-touch/
main.BACKUP-pls-dont-touch
